{
  "version": 2,
  "functions": {
    "api/cron/diary-drift.js": { "maxDuration": 60 },
    "api/cron/hotel-source-reconcile.js": { "maxDuration": 300 }
  },
  "crons": [
    {
      "path": "/api/cron/diary-drift",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/hotel-source-reconcile",
      "schedule": "30 6 * * 1"
    }
  ],
  "rewrites": [
    { "source": "/api/mc/carry-forward-queue.json", "destination": "/api/mc/carry-forward-queue" },
    { "source": "/api/mc/habit-projection.json", "destination": "/api/mc/habit-projection" },
    { "source": "/api/mc/habit-scheduled.json", "destination": "/api/mc/habit-scheduled" },
    { "source": "/api/mc/day-capacity.json", "destination": "/api/mc/day-capacity" },
    { "source": "/api/mc/task-slot-moved.json", "destination": "/api/mc/task-slot-moved" },
    { "source": "/api/mc/task-completed.json", "destination": "/api/mc/task-completed" },
    { "source": "/api/mc/rule-breach-check.json", "destination": "/api/mc/rule-breach-check" },
    { "source": "/api/mc/reconcile-due-dates.json", "destination": "/api/mc/reconcile-due-dates" },
    { "source": "/api/mc/drive-time.json", "destination": "/api/mc/drive-time" },
    { "source": "/", "destination": "/mission-control.html" },
    { "source": "/mission-control", "destination": "/mission-control.html" },
    { "source": "/handoff", "destination": "/handoff.html" },
    { "source": "/apps", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
